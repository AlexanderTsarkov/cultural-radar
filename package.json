{
  "name": "cultural-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-candidates.mjs",
    "test": "node --test",
    "build": "npm run validate:data && npm run typecheck && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "validate": "npm run format:check && npm test && npm run build && npm run smoke"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
